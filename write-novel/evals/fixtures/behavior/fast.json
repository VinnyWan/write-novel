{
  "schema_version": "write-novel-behavior-evals/v1",
  "suite": "fast",
  "description": "write-novel 行为 eval 契约。每个 case 对应一条可由 eval runner（scripts/run-behavior-evals.sh）grep/结构化校验的断言。runner 读取本文件逐 case 执行，输出 pass/fail。",
  "cases": [
    {
      "id": "skill_frontmatter",
      "type": "skill_frontmatter",
      "description": "每个 skill 的 SKILL.md 都有 name + description frontmatter，可被路由。",
      "check": "all_skills_have_frontmatter"
    },
    {
      "id": "long_write_contract",
      "type": "skill_contract",
      "skill": "story-long-write",
      "description": "/story-long-write 保留写前/写后自检、章节正式提交、状态结算、状态快照落盘的契约短语。",
      "required": [
        "Prewrite Gate",
        "Postwrite Gate",
        "CHAPTER_COMMIT",
        "追踪/快照/chapter_{N}.state.md",
        "钩子议程优先加载"
      ]
    },
    {
      "id": "gate_ordering",
      "type": "ordered_phrases",
      "skill": "story-long-write",
      "description": "单章流程执行顺序约束：写前自检先于章节正式提交，章节正式提交先于写后结算。",
      "ordered": [
        ["Prewrite Gate", "CHAPTER_COMMIT"],
        ["CHAPTER_COMMIT", "Stage G：投影"]
      ]
    },
    {
      "id": "hook_agenda_gate",
      "type": "skill_contract",
      "skill": "story-long-write",
      "description": "写后自检纳入 must_advance_hooks 履行校验，未履行经错误目录 hook-agenda-unfulfilled 报为必须处理。",
      "required": [
        "must_advance_hooks",
        "hook-agenda-unfulfilled",
        "阻塞本章提交"
      ]
    },
    {
      "id": "hook_agenda_backward_compat",
      "type": "skill_contract",
      "skill": "story-long-write",
      "description": "钩子议程字段为可选，既有细纲无该字段时跳过校验不报错（向后兼容）。",
      "required": [
        "无此两字段时跳过",
        "向后兼容既有细纲"
      ]
    },
    {
      "id": "context_truncation_policy",
      "type": "skill_contract",
      "skill": "story-long-write",
      "description": "长文件受控截断策略存在且显式标注省略，不让写手误读为全文。",
      "required": [
        "长文件受控截断",
        "省略标注",
        "context-truncation"
      ]
    },
    {
      "id": "state_snapshot_rollback",
      "type": "skill_contract",
      "skill": "story-long-write",
      "description": "按章状态快照格式与回滚流程已文档化。",
      "required": [
        "按章状态快照与回滚",
        "snapshot_chapter",
        "回滚流程"
      ]
    },
    {
      "id": "anti_ai_compliance",
      "type": "reference_exists",
      "description": "去 AI 味依赖的禁用词与反 AI 写作参考文件齐全。",
      "required_files": [
        "skills/story-deslop/references/banned-words.md",
        "skills/story-deslop/references/anti-ai-writing.md"
      ]
    },
    {
      "id": "contract_schema_fields",
      "type": "artifact_schema",
      "description": "章节合约 schema 含全部必填字段与新增钩子议程可选字段。",
      "schema_file": "references/shared/contract-schema.md",
      "required_fields": [
        "cbn",
        "cpns",
        "cen",
        "must_cover",
        "forbidden",
        "must_advance_hooks",
        "eligible_resolve_hooks"
      ]
    },
    {
      "id": "error_catalog_coverage",
      "type": "error_catalog",
      "description": "错误目录覆盖写前/写后自检失败、钩子议程未履行、字数不达标、伏笔逾期、合约字段不完整、章节提交失败、状态结算失败、细纲缺失、追踪文件缺失、断点中断、禁用词命中。",
      "catalog_file": "references/shared/author_error_catalog.json",
      "required_codes": [
        "prewrite-gate-failed",
        "postwrite-gate-failed",
        "hook-agenda-unfulfilled",
        "word-count-short",
        "foreshadow-overdue",
        "contract-schema-invalid",
        "chapter-commit-failed",
        "projection-failed",
        "outline-missing",
        "context-file-missing",
        "checkpoint-interrupted",
        "banned-words-hit"
      ]
    },
    {
      "id": "glossary_terms",
      "type": "glossary",
      "description": "作者术语表覆盖核心工程术语的作者可读名映射。",
      "glossary_file": "references/shared/author_glossary.json",
      "required_terms": [
        "frontmatter",
        "contract",
        "prewrite-gate",
        "postwrite-gate",
        "CHAPTER_COMMIT",
        "run-ledger",
        "projection",
        "state-snapshot",
        "must_advance_hooks",
        "context-truncation"
      ]
    },
    {
      "id": "report_template_references",
      "type": "shared_file_contract",
      "description": "报告模板引用错误目录与术语表，不硬编码错误文案。",
      "file": "references/shared/report-template.md",
      "required": [
        "author_error_catalog.json",
        "author_glossary.json"
      ]
    },
    {
      "id": "references_integrity",
      "type": "delegated_check",
      "description": "references 链接完整性委托 static-check.sh 校验（三级解析规则）。",
      "delegate": "scripts/static-check.sh"
    },
    {
      "id": "agent_templates_complete",
      "type": "file_exists",
      "description": "story-setup 部署的 9 个 agent 模板齐全（含补建的 deconstruction-agent 与 reviewer）。",
      "required_files": [
        "skills/story-setup/references/templates/agents/deconstruction-agent.md",
        "skills/story-setup/references/templates/agents/reviewer.md"
      ]
    },
    {
      "id": "no_bare_python3",
      "type": "delegated_check",
      "description": "hooks 与 skills 中无裸 python3 调用（Windows Store 占位程序 exit 49 风险）。",
      "delegate": "scripts/check-python-invocation.sh"
    },
    {
      "id": "shared_files_consistent",
      "type": "delegated_check",
      "description": "跨 skill 同名引用文件一致性（防副本漂移）。",
      "delegate": "scripts/check-shared-files.sh"
    },
    {
      "id": "charcount_portable",
      "type": "delegated_check",
      "description": "跨平台字符统计可移植性。",
      "delegate": "scripts/test-charcount-portable.sh"
    }
  ]
}
